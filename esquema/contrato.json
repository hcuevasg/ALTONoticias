{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Edición diaria — Barrido de Prensa ALTO (diario + boletín)",
  "description": "Objeto que produce generarEdicion() (Claude.gs) tras expandir la selección del modelo. El modelo responde una versión 'lean' (por id); acá se documenta el objeto YA EXPANDIDO que consume Render.gs. Dos productos: el diario de prensa (público en Pages) y el boletín de inteligencia ALTO (solo en el correo).",
  "type": "object",
  "required": ["fecha", "titular_principal", "secciones", "boletin"],
  "additionalProperties": false,
  "properties": {
    "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },

    "titular_principal": {
      "type": "object",
      "required": ["titular", "fuente", "url", "bajada"],
      "additionalProperties": false,
      "properties": {
        "titular": { "type": "string" },
        "fuente":  { "type": "string" },
        "url":     { "type": "string", "format": "uri" },
        "bajada":  { "type": "string" }
      }
    },

    "secciones": {
      "description": "Diario de prensa. Solo chile/politica/delictual (clientes vive en boletin).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titulo", "articulos"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["chile", "politica", "delictual"] },
          "titulo": { "type": "string" },
          "articulos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["titular", "fuente", "url", "fecha", "bajada", "relevancia"],
              "additionalProperties": false,
              "properties": {
                "titular":    { "type": "string" },
                "fuente":     { "type": "string" },
                "url":        { "type": "string", "format": "uri", "description": "OBLIGATORIA y real; sin url se descarta." },
                "fecha":      { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "bajada":     { "type": "string" },
                "relevancia": { "type": "integer", "minimum": 1, "maximum": 5 }
              }
            }
          }
        }
      }
    },

    "boletin": {
      "description": "Boletín de Inteligencia ALTO (solo correo). Niveles 2-3 del embudo.",
      "type": "object",
      "required": ["clientes_afectados", "nuevos_modus_operandi", "riesgo_por_industria"],
      "additionalProperties": false,
      "properties": {
        "clientes_afectados": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cliente", "industria", "tipo_amenaza", "impacto", "oportunidad_comercial", "titular", "fuente", "url", "fecha", "relevancia"],
            "additionalProperties": false,
            "properties": {
              "cliente":               { "type": "string" },
              "industria":             { "type": "string" },
              "tipo_amenaza":          { "type": "string" },
              "impacto":               { "type": "string", "description": "1 frase." },
              "oportunidad_comercial": { "type": "string", "description": "Servicio ALTO a ofrecer (Nivel 3)." },
              "titular":               { "type": "string" },
              "fuente":                { "type": "string" },
              "url":                   { "type": "string", "format": "uri" },
              "fecha":                 { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "relevancia":            { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          }
        },
        "nuevos_modus_operandi": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["descripcion", "titular", "fuente", "url", "fecha"],
            "additionalProperties": false,
            "properties": {
              "descripcion": { "type": "string" },
              "titular":     { "type": "string" },
              "fuente":      { "type": "string" },
              "url":         { "type": "string", "format": "uri" },
              "fecha":       { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        },
        "riesgo_por_industria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["industria", "nivel", "motivo"],
            "additionalProperties": false,
            "properties": {
              "industria": { "type": "string" },
              "nivel":     { "type": "string", "enum": ["Alto", "Medio", "Bajo"] },
              "motivo":    { "type": "string" }
            }
          }
        }
      }
    }
  }
}
