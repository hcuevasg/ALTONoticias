{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Edición diaria — Barrido de Prensa ALTO",
  "description": "Contrato JSON que Claude debe devolver EXCLUSIVAMENTE, sin prosa ni fences. Documento de referencia; el render descarta cualquier artículo sin 'url'.",
  "type": "object",
  "required": ["fecha", "titular_principal", "secciones"],
  "additionalProperties": false,
  "properties": {
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Fecha de la edición en formato ISO (YYYY-MM-DD)."
    },
    "titular_principal": {
      "type": "object",
      "required": ["titular", "fuente", "url", "bajada"],
      "additionalProperties": false,
      "properties": {
        "titular": { "type": "string" },
        "fuente":  { "type": "string" },
        "url":     { "type": "string", "format": "uri" },
        "bajada":  { "type": "string" }
      }
    },
    "secciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "titulo", "articulos"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": ["chile", "politica", "delictual", "clientes"]
          },
          "titulo": { "type": "string" },
          "articulos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["titular", "fuente", "url", "fecha", "bajada", "relevancia"],
              "additionalProperties": false,
              "properties": {
                "titular":    { "type": "string" },
                "fuente":     { "type": "string" },
                "url":        { "type": "string", "format": "uri", "description": "OBLIGATORIA y real. Sin url, el artículo se descarta antes de renderizar." },
                "fecha":      { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "bajada":     { "type": "string", "description": "2-3 frases en español." },
                "relevancia": { "type": "integer", "minimum": 1, "maximum": 5 },
                "cliente":    { "type": "string", "description": "Solo en la sección 'clientes'." }
              }
            }
          }
        }
      }
    }
  }
}
